{
  "name": "@wangmo-bit/ds-link",
  "version": "0.8.18",
  "description": "DS-link: local session collaboration with bubble and card views for DeepSeek Harness",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Wangmo-bit/DS-link.git"
  },
  "homepage": "https://github.com/Wangmo-bit/DS-link#readme",
  "bugs": {
    "url": "https://github.com/Wangmo-bit/DS-link/issues"
  },
  "author": "Wangmo-bit",
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "session-collaboration",
    "chat",
    "multi-agent"
  ],
  "icon": "assets/icon.svg",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24",
    "dsh": "0.2.1-rc.5 || 0.2.2-rc.1"
  },
  "exports": {
    ".": "./src/host/entry-0.8.18.js",
    "./runtime-0.8.18": "./src/host/entry-0.8.18.js",
    "./package.json": "./package.json",
    "./client": "./dist/client.js"
  },
  "files": [
    "src/core",
    "src/host",
    "dist",
    "cordis.patch.yml",
    "THIRD_PARTY_NOTICES.md",
    "TESTING.md",
    "assets/icon.svg"
  ],
  "scripts": {
    "test": "node scripts/run-tests.mjs",
    "build": "node scripts/build.mjs",
    "check": "npm run build && npm test",
    "prepack": "node scripts/build.mjs",
    "check:public": "node scripts/check-public.mjs",
    "docs:assets": "node scripts/render-doc-assets.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-tool",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5 || ~4.1.0",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.5 || 0.2.2-rc.1",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.5 || 0.2.2-rc.1",
    "@deepseek-ai/schemastery": "~3.18.5 || ~3.19.0",
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "esbuild": "^0.25.0",
    "playwright-core": "1.64.1",
    "react": "^18.2.0",
    "react-dom": "18.3.1",
    "zod": "4.4.3"
  }
}
